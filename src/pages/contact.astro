---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" description="문의하기">
	<h1 class="text-2xl font-bold">Contact</h1>
	<p class="mt-4 text-gray-600">아래 폼으로 연락 주세요.</p>

	<!--
		Formspree 연동: https://formspree.io 에서 무료 가입 후
		발급받은 Form ID로 아래 YOUR_FORM_ID를 교체하세요.
	-->
	<form
		action="https://formspree.io/f/YOUR_FORM_ID"
		method="POST"
		class="mt-8 flex flex-col gap-4"
	>
		<label class="flex flex-col gap-1">
			<span class="text-sm font-medium">이름</span>
			<input
				type="text"
				name="name"
				required
				class="rounded border border-gray-300 px-3 py-2"
			/>
		</label>

		<label class="flex flex-col gap-1">
			<span class="text-sm font-medium">이메일</span>
			<input
				type="email"
				name="email"
				required
				class="rounded border border-gray-300 px-3 py-2"
			/>
		</label>

		<label class="flex flex-col gap-1">
			<span class="text-sm font-medium">메시지</span>
			<textarea
				name="message"
				required
				rows="5"
				class="rounded border border-gray-300 px-3 py-2"
			></textarea>
		</label>

		<button
			type="submit"
			class="mt-2 rounded bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700"
		>
			보내기
		</button>
	</form>
</Layout>
